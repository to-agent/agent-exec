# Required
API_KEY=your-api-key-here

# Master switch — set to true to enable agent-exec
# Without this, all endpoints return 503 (except /ping)
AGENT_EXEC_ENABLED=true

# Optional
PORT=3333
LOG_LEVEL=info

# Compatibility / control-plane options
# AGENT_EXEC_ALLOW_QUERY_API_KEY=true
# AGENT_EXEC_ALLOW_TRANSFER=true
